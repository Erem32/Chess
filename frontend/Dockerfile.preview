FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ENV VITE_API_URL=http://localhost:8001
ENV VITE_WS_URL=ws://localhost:8001
RUN npm run build

FROM nginx:alpine
COPY nginx.preview.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
